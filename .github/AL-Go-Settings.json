{
  "$schema": "https://raw.githubusercontent.com/microsoft/AL-Go-Actions/v9.2/.Modules/settings.schema.json",
  "type": "PTE",
  "templateUrl": "https://github.com/roland-bc-development/AL-Go-PTE@main",
  "ConditionalSettings": [
    {
      "workflows": [
        "Update AL-Go System Files"
      ],
      "settings": {
        "workflowSchedule": {
          "cron": "0 3 * * *"
        }
      }
    }
  ],
  "useCompilerFolder": true,
  "doNotPublishApps": true,
  "doNotBuildTests": true,
  "githubRunner": "self-hosted",
  "githubRunnerShell": "powershell",
  "runs-on": "windows-latest",
  "country": "base",
  "repoVersion": "28.5",
  "artifact": "//28.5//first",
  "failOn": "error",
  "updateDependencies": false,
  "versioningStrategy": 2,
  "generateDependencyArtifact": true,
  "CICDPushBranches": [
    "main",
    "release/*"
  ]
}
