{
  "$schema": "https://raw.githubusercontent.com/microsoft/AL-Go-Actions/v9.2/.Modules/settings.schema.json",
  "type": "PTE",
  "templateUrl": "https://github.com/roland-bc-development/AL-Go-PTE@main",
  "ConditionalSettings": [
    {
      "workflows": [
        "Update AL-Go System Files"
      ],
      "settings": {
        "workflowSchedule": {
          "cron": "0 3 * * *"
        }
      }
    }
  ],
  "useCompilerFolder": true,
  "doNotPublishApps": true,
  "doNotBuildTests": true,
  "githubRunner": "self-hosted",
  "githubRunnerShell": "powershell",
  "runs-on": "windows-latest",
  "country": "base",
  "repoVersion": "28.5",
  "artifact": "//28.5//first",
  "failOn": "error",
  "updateDependencies": false,
  "versioningStrategy": 18,
  "generateDependencyArtifact": true,
  "CICDPushBranches": [
    "main",
    "release/*"
  ],
  "DeployToEUSIT": {
    "EnvironmentType": "SaaS",
    "EnvironmentName": "EU_SIT",
    "Branches": [
      "main"
    ],
    "projects": "*",
    "SyncMode": "Add",
    "Scope": "PTE",
    "ContinuousDeployment": true,
    "dependencyInstallMode": "install"
  },
   "DeployToEUQA": {
    "EnvironmentType": "SaaS",
    "EnvironmentName": "EU_DEV",
    "Branches": [
      "main"
    ],
    "projects": "*",
    "SyncMode": "Add",
    "Scope": "PTE",
    "ContinuousDeployment": true,
    "dependencyInstallMode": "install"
  },
   "DeployToEUPROD": {
    "EnvironmentType": "SaaS",
    "EnvironmentName": "EU_QA",
    "Branches": [
      "main",
      "release/*"
    ],
    "projects": "*",
    "SyncMode": "Add",
    "Scope": "PTE",
    "ContinuousDeployment": false,
    "dependencyInstallMode": "install"
  },
    "projects": "*",
    "SyncMode": "Add",
    "Scope": "PTE",
    "ContinuousDeployment": true,
    "dependencyInstallMode": "install"
  },
  "rolandBuildTargets": {
    "version": "28.5.0.0",
    "platform": "28.0.0.0",
    "application": "28.5.0.0",
    "runtime": "17.0",
    "dependencyPublishers": [
      "Microsoft"
    ]
  }
}
